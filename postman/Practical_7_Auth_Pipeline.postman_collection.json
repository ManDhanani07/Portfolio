{
	"info": {
		"_postman_id": "practical-7-jwt-auth-middleware-pipeline",
		"name": "Practical 7 — JWT Authentication & Middleware Pipeline",
		"description": "Postman Collection for Practical 7: User Registration, Login, JWT Token Generation, Auth Middleware, Server-Side Validation, /me Endpoint, and Protected Task CRUD.",
		"schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
	},
	"variable": [
		{
			"key": "base_url",
			"value": "http://localhost:5000",
			"type": "string"
		},
		{
			"key": "jwt_token",
			"value": "",
			"type": "string"
		},
		{
			"key": "task_id",
			"value": "",
			"type": "string"
		}
	],
	"item": [
		{
			"name": "1. Auth - Register User",
			"event": [
				{
					"listen": "test",
					"script": {
						"exec": [
							"pm.test(\"Status code is 201 Created\", function () {",
							"    pm.response.to.have.status(201);",
							"});",
							"pm.test(\"Password is NOT in response\", function () {",
							"    var jsonData = pm.response.json();",
							"    pm.expect(jsonData.user.password).to.be.undefined;",
							"});"
						],
						"type": "text/javascript"
					}
				}
			],
			"request": {
				"method": "POST",
				"header": [
					{
						"key": "Content-Type",
						"value": "application/json"
					}
				],
				"body": {
					"mode": "raw",
					"raw": "{\n  \"email\": \"student@gmail.com\",\n  \"password\": \"123456\"\n}"
				},
				"url": {
					"raw": "{{base_url}}/api/auth/register",
					"host": [
						"{{base_url}}"
					],
					"path": [
						"api",
						"auth",
						"register"
					]
				},
				"description": "Registers a new user with hashed password (bcryptjs 10 salt rounds)."
			}
		},
		{
			"name": "2. Auth - Login User (Extracts Token)",
			"event": [
				{
					"listen": "test",
					"script": {
						"exec": [
							"pm.test(\"Status code is 200 OK\", function () {",
							"    pm.response.to.have.status(200);",
							"});",
							"var jsonData = pm.response.json();",
							"if (jsonData.token) {",
							"    pm.collectionVariables.set(\"jwt_token\", jsonData.token);",
							"    console.log(\"Saved JWT Token to collection variables\");",
							"}"
						],
						"type": "text/javascript"
					}
				}
			],
			"request": {
				"method": "POST",
				"header": [
					{
						"key": "Content-Type",
						"value": "application/json"
					}
				],
				"body": {
					"mode": "raw",
					"raw": "{\n  \"email\": \"student@gmail.com\",\n  \"password\": \"123456\"\n}"
				},
				"url": {
					"raw": "{{base_url}}/api/auth/login",
					"host": [
						"{{base_url}}"
					],
					"path": [
						"api",
						"auth",
						"login"
					]
				},
				"description": "Authenticates user credentials and returns JWT token."
			}
		},
		{
			"name": "3. Auth - GET /me (Protected)",
			"event": [
				{
					"listen": "test",
					"script": {
						"exec": [
							"pm.test(\"Status code is 200 OK\", function () {",
							"    pm.response.to.have.status(200);",
							"});",
							"pm.test(\"Returns user info without password\", function () {",
							"    var jsonData = pm.response.json();",
							"    pm.expect(jsonData.email).to.eql(\"student@gmail.com\");",
							"    pm.expect(jsonData.password).to.be.undefined;",
							"});"
						],
						"type": "text/javascript"
					}
				}
			],
			"request": {
				"method": "GET",
				"header": [
					{
						"key": "Authorization",
						"value": "Bearer {{jwt_token}}"
					}
				],
				"url": {
					"raw": "{{base_url}}/api/auth/me",
					"host": [
						"{{base_url}}"
					],
					"path": [
						"api",
						"auth",
						"me"
					]
				},
				"description": "Returns current authenticated user details from req.user decoded JWT."
			}
		},
		{
			"name": "4. Tasks - GET /api/tasks (Unauthorized - Missing Token -> 401)",
			"event": [
				{
					"listen": "test",
					"script": {
						"exec": [
							"pm.test(\"Status code is 401 Unauthorized\", function () {",
							"    pm.response.to.have.status(401);",
							"});"
						],
						"type": "text/javascript"
					}
				}
			],
			"request": {
				"method": "GET",
				"header": [],
				"url": {
					"raw": "{{base_url}}/api/tasks",
					"host": [
						"{{base_url}}"
					],
					"path": [
						"api",
						"tasks"
					]
				},
				"description": "Demonstrates authMiddleware rejecting request without Bearer token."
			}
		},
		{
			"name": "5. Tasks - GET /api/tasks (Authorized - Bearer Token -> 200)",
			"event": [
				{
					"listen": "test",
					"script": {
						"exec": [
							"pm.test(\"Status code is 200 OK\", function () {",
							"    pm.response.to.have.status(200);",
							"});",
							"pm.test(\"Response is an array\", function () {",
							"    var jsonData = pm.response.json();",
							"    pm.expect(Array.isArray(jsonData)).to.be.true;",
							"});"
						],
						"type": "text/javascript"
					}
				}
			],
			"request": {
				"method": "GET",
				"header": [
					{
						"key": "Authorization",
						"value": "Bearer {{jwt_token}}"
					}
				],
				"url": {
					"raw": "{{base_url}}/api/tasks",
					"host": [
						"{{base_url}}"
					],
					"path": [
						"api",
						"tasks"
					]
				},
				"description": "Demonstrates authMiddleware allowing request with valid Bearer token."
			}
		},
		{
			"name": "6. Tasks - POST /api/tasks (Valid Task Body -> 201)",
			"event": [
				{
					"listen": "test",
					"script": {
						"exec": [
							"pm.test(\"Status code is 201 Created\", function () {",
							"    pm.response.to.have.status(201);",
							"});",
							"var jsonData = pm.response.json();",
							"if (jsonData._id) {",
							"    pm.collectionVariables.set(\"task_id\", jsonData._id);",
							"}"
						],
						"type": "text/javascript"
					}
				}
			],
			"request": {
				"method": "POST",
				"header": [
					{
						"key": "Content-Type",
						"value": "application/json"
					},
					{
						"key": "Authorization",
						"value": "Bearer {{jwt_token}}"
					}
				],
				"body": {
					"mode": "raw",
					"raw": "{\n  \"title\": \"Complete Practical 7 Viva Presentation\",\n  \"description\": \"Demonstrate authentication and middleware pipeline\",\n  \"status\": \"In Progress\",\n  \"priority\": \"High\"\n}"
				},
				"url": {
					"raw": "{{base_url}}/api/tasks",
					"host": [
						"{{base_url}}"
					],
					"path": [
						"api",
						"tasks"
					]
				},
				"description": "Creates a task passing both authMiddleware and validateTask."
			}
		},
		{
			"name": "7. Tasks - POST /api/tasks (Validation Error - Missing Title -> 400)",
			"event": [
				{
					"listen": "test",
					"script": {
						"exec": [
							"pm.test(\"Status code is 400 Bad Request\", function () {",
							"    pm.response.to.have.status(400);",
							"});"
						],
						"type": "text/javascript"
					}
				}
			],
			"request": {
				"method": "POST",
				"header": [
					{
						"key": "Content-Type",
						"value": "application/json"
					},
					{
						"key": "Authorization",
						"value": "Bearer {{jwt_token}}"
					}
				],
				"body": {
					"mode": "raw",
					"raw": "{\n  \"title\": \"   \",\n  \"description\": \"Missing or whitespace-only title\"\n}"
				},
				"url": {
					"raw": "{{base_url}}/api/tasks",
					"host": [
						"{{base_url}}"
					],
					"path": [
						"api",
						"tasks"
					]
				},
				"description": "Demonstrates validateTask middleware rejecting missing/empty title."
			}
		},
		{
			"name": "8. Tasks - PUT /api/tasks/:id (Update Task -> 200)",
			"event": [
				{
					"listen": "test",
					"script": {
						"exec": [
							"pm.test(\"Status code is 200 OK\", function () {",
							"    pm.response.to.have.status(200);",
							"});"
						],
						"type": "text/javascript"
					}
				}
			],
			"request": {
				"method": "PUT",
				"header": [
					{
						"key": "Content-Type",
						"value": "application/json"
					},
					{
						"key": "Authorization",
						"value": "Bearer {{jwt_token}}"
					}
				],
				"body": {
					"mode": "raw",
					"raw": "{\n  \"title\": \"Complete Practical 7 Viva Presentation (Updated)\",\n  \"description\": \"Updated description with Completed status\",\n  \"status\": \"Completed\",\n  \"priority\": \"High\"\n}"
				},
				"url": {
					"raw": "{{base_url}}/api/tasks/{{task_id}}",
					"host": [
						"{{base_url}}"
					],
					"path": [
						"api",
						"tasks",
						"{{task_id}}"
					]
				},
				"description": "Updates task by ID with Bearer auth and validation."
			}
		},
		{
			"name": "9. Tasks - DELETE /api/tasks/:id (Delete Task -> 200)",
			"event": [
				{
					"listen": "test",
					"script": {
						"exec": [
							"pm.test(\"Status code is 200 OK\", function () {",
							"    pm.response.to.have.status(200);",
							"});"
						],
						"type": "text/javascript"
					}
				}
			],
			"request": {
				"method": "DELETE",
				"header": [
					{
						"key": "Authorization",
						"value": "Bearer {{jwt_token}}"
					}
				],
				"url": {
					"raw": "{{base_url}}/api/tasks/{{task_id}}",
					"host": [
						"{{base_url}}"
					],
					"path": [
						"api",
						"tasks",
						"{{task_id}}"
					]
				},
				"description": "Deletes task by ID using authMiddleware."
			}
		},
		{
			"name": "10. Tasks - GET /api/tasks (Invalid / Expired Token -> 401)",
			"event": [
				{
					"listen": "test",
					"script": {
						"exec": [
							"pm.test(\"Status code is 401 Unauthorized\", function () {",
							"    pm.response.to.have.status(401);",
							"});"
						],
						"type": "text/javascript"
					}
				}
			],
			"request": {
				"method": "GET",
				"header": [
					{
						"key": "Authorization",
						"value": "Bearer invalid_token_12345_sample"
					}
				],
				"url": {
					"raw": "{{base_url}}/api/tasks",
					"host": [
						"{{base_url}}"
					],
					"path": [
						"api",
						"tasks"
					]
				},
				"description": "Demonstrates authMiddleware rejecting invalid or forged JWT."
			}
		}
	]
}
